{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@server/*": ["./src/server/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"],
      "@utils/*": ["./src/utils/*"],
      "@app-types/*": ["./src/types/*"],
      "@styles/*": ["./src/styles/*"],
      "@data/*": ["./src/data/*"],
      "@config": ["./src/config.ts"],
      "@assets/*": ["./src/assets/*"]
    }
  },
  "mdx": {
    "checkMdx": true
  },
  "include": [
    "src/**/*.astro",
    "src/**/*.ts",
    "src/**/*.svelte",
    "uno.config.ts",
    "astro.config.ts"
  ]
}
