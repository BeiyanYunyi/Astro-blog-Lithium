---
import { getCollection, render } from 'astro:content';
import BlogPost from '@components/BlogPost.astro';
import FederatedComments from '@components/FederatedComments.astro';
import { filePathToSlug } from '@utils/idToSlug';

export const prerender = false;

const entries = await getCollection('posts');
const entry = entries.find(
  (post) => filePathToSlug(post.filePath) === Astro.params.slug,
);
if (!entry) return new Response('Not Found', { status: 404 });
if (
  ['GET', 'HEAD'].includes(Astro.request.method) &&
  !Astro.url.pathname.endsWith('/')
) {
  return Astro.redirect(`${Astro.url.pathname}/${Astro.url.search}`, 301);
}
if (entry.data.draft) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}
const { Content, headings } = await render(entry);
---

<BlogPost
  title={entry.data.title}
  date={entry.data.date}
  headings={headings}
  slug={filePathToSlug(entry.filePath)}
  description={entry.data.description}
  tag={entry.data.tag}
  image={entry.data.image}
>
  <Content />
  <FederatedComments
    slot="after-article"
    postId={filePathToSlug(entry.filePath)}
  />
</BlogPost>
