---
import {
  looksLikePreview,
  type TrapRow,
  type TrapVia,
  truncateIp,
  uaName,
} from '@server/crawlerTrap';

export interface Props {
  rows: TrapRow[];
}

const { rows } = Astro.props;
const now = Date.now();
const uaPreviewLength = 72;
const formatTime = (value: number) =>
  `${new Date(value).toISOString().slice(0, 16).replace('T', ' ')} UTC`;
const formatAgo = (value: number) => {
  const minutes = Math.max(0, Math.floor((now - value) / 60_000));
  if (minutes < 1) return '刚刚';
  if (minutes < 60) return `${minutes}分钟前`;
  if (minutes < 24 * 60) return `${Math.floor(minutes / 60)}小时前`;
  if (minutes < 30 * 24 * 60) return `${Math.floor(minutes / 60 / 24)}天前`;
  return new Date(value).toISOString().slice(0, 10);
};
const sections: { via: TrapVia; title: string; note: string }[] = [
  {
    via: 'link',
    title: '顺着隐藏链接爬进来的',
    note: '页脚里有一个对人类不可见、未在任何地方公开、但被robots.txt禁止访问的链接。会走到这里的，基本是顺着链接一路抓取全站的内容爬虫。',
  },
  {
    via: 'robots',
    title: '照着robots.txt找上门的',
    note: '这个路径只出现在robots.txt的Disallow里。会走到这里的，是读了robots.txt、专门去访问被禁止路径的程序，多为安全扫描器——以及好奇的人类。',
  },
];
---

{sections.map((section) => {
  const list = rows.filter((row) => row.via === section.via);
  const hits = list.reduce((sum, row) => sum + row.hit_count, 0);
  return (
    <section>
      <h2>{section.title}</h2>
      <p>{section.note}</p>
      {list.length === 0 ? (
        <p class="not-prose summary">暂时还没有。</p>
      ) : (
        <>
          <p class="not-prose summary">
            {list.length}个来源，共{hits}次访问
          </p>
          <ol class="not-prose entries">
            {list.map((row) => (
              <li class:list={['entry', { preview: looksLikePreview(row.ua) }]}>
                <div class="entry-head">
                  <span class="name">
                    {row.ua === '' ? '未发送UA' : uaName(row.ua)}
                  </span>
                  {looksLikePreview(row.ua) && (
                    <span
                      class="tag"
                      title="可能是有人分享了链接，由聊天软件或联邦宇宙实例抓取预览"
                    >
                      疑似链接预览
                    </span>
                  )}
                  <span class="count">
                    <b>{row.hit_count}</b>次
                  </span>
                </div>
                <p class="origin">
                  {row.as_org ?? '未知网络'}
                  <span class="muted">
                    {row.asn !== null && (
                      <a
                        href={`https://bgp.he.net/AS${row.asn}`}
                        target="_blank"
                        rel="noopener noreferrer nofollow"
                      >
                        AS{row.asn}
                      </a>
                    )}
                    {row.asn !== null && row.country && ' · '}
                    {row.country}
                  </span>
                </p>
                <p class="meta">
                  <code>{truncateIp(row.ip)}</code>
                  <span>
                    最近
                    <time
                      datetime={new Date(row.last_seen).toISOString()}
                      title={formatTime(row.last_seen)}
                    >
                      {formatAgo(row.last_seen)}
                    </time>
                  </span>
                  <span>
                    首次
                    <time
                      datetime={new Date(row.first_seen).toISOString()}
                      title={formatTime(row.first_seen)}
                    >
                      {formatAgo(row.first_seen)}
                    </time>
                  </span>
                </p>
                {row.ua !== '' &&
                  (row.ua.length > uaPreviewLength ? (
                    <details class="ua">
                      <summary>
                        <code>{row.ua.slice(0, uaPreviewLength)}…</code>
                      </summary>
                      <code>{row.ua}</code>
                    </details>
                  ) : (
                    <code class="ua">{row.ua}</code>
                  ))}
              </li>
            ))}
          </ol>
        </>
      )}
    </section>
  );
})}

<style>
  .summary {
    margin-block: 0.5rem 1rem;
    font-size: 0.875rem;
    opacity: 0.75;
  }
  .entries {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }
  .entry {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.9rem 1rem;
    border: 1px solid #8884;
    border-left: 4px solid #ef4444aa;
    border-radius: 0.5rem;
  }
  .entry.preview {
    border-left-color: #f59e0baa;
    opacity: 0.8;
  }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .name {
    font-size: 1.125rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .count {
    margin-left: auto;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .count b {
    margin-right: 0.125rem;
    font-size: 1.25rem;
  }
  .origin {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .origin .muted {
    margin-left: 0.5rem;
    font-size: 0.875rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.75;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8125rem;
  }
  .ua {
    display: block;
    font-size: 0.8125rem;
    opacity: 0.75;
    overflow-wrap: anywhere;
  }
  .ua summary {
    cursor: pointer;
  }
  .ua[open] summary {
    margin-bottom: 0.25rem;
  }
  .muted {
    opacity: 0.7;
  }
  .tag {
    padding: 0 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    background: #f59e0b33;
  }
</style>
