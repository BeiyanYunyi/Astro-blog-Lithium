---
import {
  looksLikePreview,
  type TrapRow,
  type TrapVia,
  truncateIp,
  uaName,
} from '@server/crawlerTrap';

export interface Props {
  rows: TrapRow[];
}

const { rows } = Astro.props;
const now = Date.now();
const uaPreviewLength = 72;
const codeClass = 'text-[0.8125rem]';
const formatTime = (value: number) =>
  `${new Date(value).toISOString().slice(0, 16).replace('T', ' ')} UTC`;
const formatAgo = (value: number) => {
  const minutes = Math.max(0, Math.floor((now - value) / 60_000));
  if (minutes < 1) return '刚刚';
  if (minutes < 60) return `${minutes}分钟前`;
  if (minutes < 24 * 60) return `${Math.floor(minutes / 60)}小时前`;
  if (minutes < 30 * 24 * 60) return `${Math.floor(minutes / 60 / 24)}天前`;
  return new Date(value).toISOString().slice(0, 10);
};
const sections: { via: TrapVia; title: string; note: string }[] = [
  {
    via: 'link',
    title: '顺着隐藏链接爬进来的',
    note: '页脚里有一个对人类不可见、未在任何地方公开、但被robots.txt禁止访问的链接。会走到这里的，基本是顺着链接一路抓取全站的内容爬虫。',
  },
  {
    via: 'robots',
    title: '照着robots.txt找上门的',
    note: '这个路径只出现在robots.txt的Disallow里。会走到这里的，是读了robots.txt、专门去访问被禁止路径的程序，多为安全扫描器——以及好奇的人类。',
  },
];
---

{sections.map((section) => {
  const list = rows.filter((row) => row.via === section.via);
  const hits = list.reduce((sum, row) => sum + row.hit_count, 0);
  return (
    <section>
      <h2>{section.title}</h2>
      <p>{section.note}</p>
      {list.length === 0 ? (
        <p class="not-prose mt-2 mb-4 text-[0.875rem] opacity-75">
          暂时还没有。
        </p>
      ) : (
        <>
          <p class="not-prose mt-2 mb-4 text-[0.875rem] opacity-75">
            {list.length}个来源，共{hits}次访问
          </p>
          <ol class="not-prose grid gap-3 m-0 mb-8 p-0 list-none">
            {list.map((row) => (
              <li
                class:list={[
                  'grid gap-[0.35rem] min-w-0 px-4 py-[0.9rem] border border-l-4 rounded-lg [border-color:#8884]',
                  looksLikePreview(row.ua)
                    ? '[border-left-color:#f59e0baa] opacity-80'
                    : '[border-left-color:#ef4444aa]',
                ]}
              >
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="text-[1.125rem] font-bold break-anywhere">
                    {row.ua === '' ? '未发送UA' : uaName(row.ua)}
                  </span>
                  {looksLikePreview(row.ua) && (
                    <span
                      class="px-[0.4rem] rounded text-[0.75rem] [background-color:#f59e0b33]"
                      title="可能是有人分享了链接，由聊天软件或联邦宇宙实例抓取预览"
                    >
                      疑似链接预览
                    </span>
                  )}
                  <span class="ml-auto text-[0.875rem] whitespace-nowrap">
                    <b class="mr-0.5 text-[1.25rem]">{row.hit_count}</b>次
                  </span>
                </div>
                <p class="m-0 break-anywhere">
                  {row.as_org ?? '未知网络'}
                  <span class="ml-2 text-[0.875rem] opacity-70">
                    {row.asn !== null && (
                      <a
                        href={`https://bgp.he.net/AS${row.asn}`}
                        target="_blank"
                        rel="noopener noreferrer nofollow"
                      >
                        AS{row.asn}
                      </a>
                    )}
                    {row.asn !== null && row.country && ' · '}
                    {row.country}
                  </span>
                </p>
                <p class="flex flex-wrap gap-x-4 gap-y-1 m-0 text-[0.8125rem] opacity-75">
                  <code class={codeClass}>{truncateIp(row.ip)}</code>
                  <span>
                    最近
                    <time
                      datetime={new Date(row.last_seen).toISOString()}
                      title={formatTime(row.last_seen)}
                    >
                      {formatAgo(row.last_seen)}
                    </time>
                  </span>
                  <span>
                    首次
                    <time
                      datetime={new Date(row.first_seen).toISOString()}
                      title={formatTime(row.first_seen)}
                    >
                      {formatAgo(row.first_seen)}
                    </time>
                  </span>
                </p>
                {row.ua !== '' &&
                  (row.ua.length > uaPreviewLength ? (
                    <details class="group block text-[0.8125rem] opacity-75 break-anywhere">
                      <summary class="cursor-pointer group-open:mb-1">
                        <code class={codeClass}>
                          {row.ua.slice(0, uaPreviewLength)}…
                        </code>
                      </summary>
                      <code class={codeClass}>{row.ua}</code>
                    </details>
                  ) : (
                    <code
                      class:list={[
                        codeClass,
                        'block opacity-75 break-anywhere',
                      ]}
                    >
                      {row.ua}
                    </code>
                  ))}
              </li>
            ))}
          </ol>
        </>
      )}
    </section>
  );
})}
