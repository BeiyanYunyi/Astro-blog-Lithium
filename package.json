  "description": "拿去吧！",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "cross-env DEV=true astro dev --host",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "worker:dev": "astro dev --host",
    "worker:check": "tsc --project tsconfig.worker.json --noEmit",
    "worker:dry-run": "cf deploy --prebuilt --dry-run",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "test:worker": "node --test tests/worker.test.ts",
    "check": "oxfmt --check . && oxlint .",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.1",
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@fedify/cfworkers": "^2.4.5",
    "@fedify/fedify": "^2.4.5",
    "@fedify/vocab": "^2.4.5",
    "@iconify-json/ion": "^1.2.7",
    "@logtape/logtape": "^2.4.2",
    "@unocss/reset": "^66.12.0",
    "astro": "^7.4.7",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "1.0.0-rc.4",
    "katex": "^0.19.1",
    "satteri": "^0.11.6",
