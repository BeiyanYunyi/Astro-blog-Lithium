    "unocss": "^66.12.0",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@unocss/astro": "^66.12.0",
    "cf": "1.0.0-beta.28",
    "miniflare": "5.20260903.0-alpha",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "rollup": "^4.67.5",
    "svelte-check": "^4.7.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
